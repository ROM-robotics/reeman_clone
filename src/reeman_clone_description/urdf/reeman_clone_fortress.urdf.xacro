<?xml version="1.0" encoding="utf-8"?>
<!-- Derived from `urdf/reemen-clone.urdf` (SolidWorks exporter output). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reemen">
  <!-- Mesh paths use `package://my_robot/...` so Gazebo can resolve them via `GZ_SIM_RESOURCE_PATH` / `IGN_GAZEBO_RESOURCE_PATH`. -->

  <xacro:arg name="robot_namespace" default="/"/>
  <xacro:arg name="controller_yaml" default="$(find reeman_clone_description)/config/diff_drive_controller.yaml"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- ROM DYNAMICS ADD -->
  <link name="camera_link"/>
  <joint name="camera_link_to_base_link" type="fixed">
    <origin xyz="0.1 0 1.3" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="three_d_camera_link"/>
  <joint name="three_d_camera_link_to_base_link" type="fixed">
    <origin xyz="0.25 0 0.15" rpy="0 -0.78 0"/>
    <parent link="base_link"/>
    <child link="three_d_camera_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="laser"/>
  <joint name="laser_to_base_link" type="fixed">
    <origin xyz="0.23 0 0.23" rpy="3.14 0 0"/>
    <parent link="base_link"/>
    <child link="laser"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="usb_imu_link"/>
  <joint name="usb_imu_link_to_base_link" type="fixed">
    <origin xyz="0.07 0 0.05" rpy="0 3.14 -1.57"/>
    <parent link="base_link"/>
    <child link="usb_imu_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="board_imu_link"/>
  <joint name="board_imu_link_to_base_link" type="fixed">
    <origin xyz="0.07 0 0.18" rpy="0 0 3.14"/>
    <parent link="base_link"/>
    <child link="board_imu_link"/>
    <axis xyz="0 0 0"/>
  </joint>  
  <!-- ROM DYNAMICS END -->

  <link
    name="base_link">
    <inertial>
      <origin xyz="-0.02 0.0 -0.05" rpy="0 0 0" />
      <mass value="10.0" /> <inertia
        ixx="0.077"
        ixy="0"
        ixz="0"
        iyy="0.108"
        iyz="0"
        izz="0.161" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <!-- <color rgba="0.62745 0.62745 0.62745 1" /> -->
        <color rgba="1.0 0.5 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <!-- Simplified hull collision to avoid snagging on scanned-floor micro triangles. -->
      <origin
        xyz="0 0 0.08"
        rpy="0 0 0" />
      <geometry>
        <box size="0.34 0.28 0.12"/>
      </geometry>
    </collision>
  </link>

  <link
    name="right_wheel_link">
    <inertial>
      <origin
        xyz="-1.22238889496695E-09 0.00261076778922065 1.06166525570828E-09"
        rpy="0 0 0" />
      <mass
        value="1.13468316605061" />
      <inertia
        ixx="0.00214377738340467"
        ixy="1.90141727129734E-09"
        ixz="-8.50793852563956E-12"
        iyy="0.00371288553259231"
        iyz="-9.49731061124577E-10"
        izz="0.00214377736881791" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/right_wheel_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <!-- Use a simple cylinder collision for stable wheel-ground contact in Gazebo. -->
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.085" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="right_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.000612714327570671 -0.178737474015559 -0.0067060362648815"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="right_wheel_link" />
    <axis
      xyz="0 1 0" />
    <!-- effort limit gives Gazebo ODE motor a non-zero max force budget;
         without this, velocity commands have no traction and robot won't move -->
    <limit effort="10.0" velocity="15.0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <link
    name="left_wheel_link">
    <inertial>
      <origin
        xyz="1.56960827668584E-09 -0.00261076778922059 -3.97111538097406E-10"
        rpy="0 0 0" />
      <mass
        value="1.1346831660506" />
      <inertia
        ixx="0.00214377738155265"
        ixy="1.86551956893084E-09"
        ixz="-9.79641792816089E-12"
        iyy="0.00371288553259228"
        iyz="-1.0184368717158E-09"
        izz="0.0021437773706699" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/left_wheel_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <!-- Use a simple cylinder collision for stable wheel-ground contact in Gazebo. -->
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.085" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="left_wheel_joint"
    type="continuous">
    <origin
      xyz="-0.00111271860764666 0.186733072210104 -0.0067060362648807"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="left_wheel_link" />
    <axis
      xyz="0 1 0" />
    <limit effort="10.0" velocity="15.0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <link
    name="front_right_caster_link">
    <inertial>
      <origin
        xyz="9.80282521823028E-12 3.37561645302742E-11 -1.03845265719826E-11"
        rpy="0 0 0" />
      <mass
        value="0.0103871549572359" />
      <inertia
        ixx="9.72294235682643E-07"
        ixy="5.19022156708706E-09"
        ixz="4.6110233329234E-15"
        iyy="1.47607253400214E-06"
        iyz="4.47572669905215E-13"
        izz="9.72240768629537E-07" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/front_right_caster_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- Actual STL radius: x/z extents ±0.016m -->
        <sphere radius="0.016"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="front_right_caster_joint"
    type="fixed">
    <origin
      xyz="0.16615 -0.074374 -0.073"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="front_right_caster_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link
    name="front_left_caster_link">
    <inertial>
      <origin
        xyz="0 2.77555756156289E-17 0"
        rpy="0 0 0" />
      <mass
        value="0.0103871549572359" />
      <inertia
        ixx="9.7503779582315E-07"
        ixy="-3.74373788735228E-08"
        ixz="-1.59185679989932E-14"
        iyy="1.4733289738613E-06"
        iyz="2.13068500263688E-13"
        izz="9.72240768629193E-07" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/front_left_caster_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="front_left_caster_joint"
    type="fixed">
    <origin
      xyz="0.16674791871922 0.0817655257441773 -0.073"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="front_left_caster_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link
    name="back_right_caster_link">
    <inertial>
      <origin
        xyz="0 1.38777878078145E-17 -2.77555756156289E-17"
        rpy="0 0 0" />
      <mass
        value="0.0103871549572359" />
      <inertia
        ixx="9.81214153150242E-07"
        ixy="6.66410857927456E-08"
        ixz="3.42446508638621E-23"
        iyy="1.4671526165342E-06"
        iyz="9.21100098637752E-23"
        izz="9.72240768629191E-07" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/back_right_caster_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="back_right_caster_joint"
    type="fixed">
    <origin
      xyz="-0.16677 -0.073778 -0.073"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="back_right_caster_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link
    name="back_left_caster_link">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="0.01" />
      <!-- Small but non-zero inertia to prevent Gazebo physics NaN -->
      <inertia
        ixx="9.72E-07"
        ixy="0"
        ixz="0"
        iyy="1.47E-06"
        iyz="0"
        izz="9.72E-07" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reeman_clone_description/meshes/back_left_caster_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.016"/>
      </geometry>
    </collision>
  </link>

  <joint
    name="back_left_caster_joint"
    type="fixed">
    <origin
      xyz="-0.166770030766659 0.0817624983187506 -0.073"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="back_left_caster_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <ros2_control name="DiffBotSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- COLOR -->
  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- === Wheel friction: HIGH so wheels grip the ground and propel the robot === -->
  <gazebo reference="left_wheel_link">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
          <torsional>
            <coefficient>0.001</coefficient>
            <use_patch_radius>true</use_patch_radius>
            <patch_radius>0.085</patch_radius>
          </torsional>
        </friction>
        <contact>
          <ode>
            <kp>1e7</kp>
            <kd>1.0</kd>
            <max_vel>0.01</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
          <torsional>
            <coefficient>0.001</coefficient>
            <use_patch_radius>true</use_patch_radius>
            <patch_radius>0.085</patch_radius>
          </torsional>
        </friction>
        <contact>
          <ode>
            <kp>1e7</kp>
            <kd>1.0</kd>
            <max_vel>0.01</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- === Caster friction: NEAR-ZERO so they slide freely === -->
  <gazebo reference="front_right_caster_link">
    <collision>
      <surface>
        <friction>
          <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
        </friction>
	<contact><ode><kp>1e7</kp><kd>1.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="front_left_caster_link">
    <collision>
      <surface>
        <friction>
          <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
        </friction>
	<contact><ode><kp>1e7</kp><kd>1.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="back_right_caster_link">
    <collision>
      <surface>
        <friction>
          <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
        </friction>
	<contact><ode><kp>1e7</kp><kd>1.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="back_left_caster_link">
    <collision>
      <surface>
        <friction>
          <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
        </friction>
	<contact><ode><kp>1e7</kp><kd>1.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
      </surface>
    </collision>
  </gazebo>

  <!-- IMU sensors -->
<gazebo reference="usb_imu_link">
  <sensor name="usb_imu_sensor" type="imu">
    <always_on>1</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>/imu/out</topic>
    <gz_frame_id>usb_imu_link</gz_frame_id> 
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>
  
<gazebo reference="board_imu_link">
  <sensor name="board_imu_sensor" type="imu">
    <always_on>1</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>/imu/wit/out</topic>
    <gz_frame_id>board_imu_link</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

  <!-- RGB Camera sensor -->
<gazebo reference="camera_link">
  <sensor name="camera_sensor" type="camera">
    <ign_frame_id>camera_link_optical</ign_frame_id>
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <topic>/camera/image_raw</topic>
    
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100.0</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
    </camera>
  </sensor>
</gazebo>

  <!-- 3D Camera (RGBD) sensor -->
  <gazebo reference="three_d_camera_link">
    <sensor name="rgbd_camera_sensor" type="rgbd_camera">
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <topic>/three_d_camera</topic>
      
      <gz_frame_id>three_d_camera_link_optical</gz_frame_id>
      
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far> </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <!-- GPU Lidar sensor (360° 2D scan) -->
  <gazebo reference="laser">
    <sensor name="gpu_lidar_sensor" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.08</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        <namespace>$(arg robot_namespace)</namespace>
      </ros>
      <parameters>$(arg controller_yaml)</parameters>
    </plugin>
  </gazebo>
</robot>

