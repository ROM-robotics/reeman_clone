<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="sensors_world">
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1.0</ambient>
      <background>0.85 0.85 0.85 1.0</background>
    </scene>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.45 0.45 0.45 1.0</diffuse>
      <specular>0.05 0.05 0.05 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <model name="office_polycam">
      <static>true</static>
      <link name="link">
        <!-- Polycam (iPhone) exports Y-up; rotate 90° around X to convert to
             Gazebo Z-up. Offset 1.242 = 1.570 - 0.328: shifts main-room floor
             (mesh_y≈-1.242) to world z=0, matching the physics drivable_floor. -->
        <pose>0 0 1.242 1.5708 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh>
              <!-- Full-resolution mesh with texture for rendering -->
              <uri>model://reeman_clone_description/meshes/office_polycam/25_05_2026.obj</uri>
            </mesh>
          </geometry>
        </visual>
        <!-- Keep scanned mesh visual only; use a clean analytic floor collider below. -->
      </link>
    </model>

    <!-- Stable drivable floor for robot physics (prevents wheel sink on noisy scan mesh). -->
    <model name="drivable_floor">
      <static>true</static>
      <!-- Top surface at z=0.00: polycam visual floor Y_min=-1.5699, +1.570 offset = z~0 -->
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 10 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Ground plane: safety net if robot exits the room mesh area (prevents falling to -inf) -->
    <model name="ground_plane">
      <static>true</static>
      <!-- Secondary safety net far below playable floor. -->
      <pose>0 0 -2.00 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
